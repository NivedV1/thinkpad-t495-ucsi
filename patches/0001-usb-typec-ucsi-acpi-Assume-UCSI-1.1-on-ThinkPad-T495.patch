--- a/drivers/usb/typec/ucsi/ucsi_acpi.c
+++ b/drivers/usb/typec/ucsi/ucsi_acpi.c
@@ -143,6 +143,33 @@
 	.async_control = ucsi_acpi_async_control
 };
 
+static int ucsi_t495_read_version(struct ucsi *ucsi, u16 *version)
+{
+	struct ucsi_acpi *ua = ucsi_get_drvdata(ucsi);
+	int ret;
+
+	ret = ucsi_acpi_read_version(ucsi, version);
+	if (ret)
+		return ret;
+
+	/* Firmware never fills in VERSION, it reads 0x0000 permanently */
+	if (!*version) {
+		dev_warn(ua->dev, "UCSI version is zero, assuming 1.1\n");
+		*version = UCSI_VERSION_1_1;
+	}
+
+	return 0;
+}
+
+static const struct ucsi_operations ucsi_t495_ops = {
+	.read_version = ucsi_t495_read_version,
+	.read_cci = ucsi_acpi_read_cci,
+	.poll_cci = ucsi_acpi_poll_cci,
+	.read_message_in = ucsi_acpi_read_message_in,
+	.sync_control = ucsi_sync_control_common,
+	.async_control = ucsi_acpi_async_control
+};
+
 static const struct dmi_system_id ucsi_acpi_quirks[] = {
 	{
 		.matches = {
@@ -152,6 +179,13 @@
 		},
 		.driver_data = (void *)&ucsi_gram_ops,
 	},
+	{
