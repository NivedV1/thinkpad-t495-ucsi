+			DMI_MATCH(DMI_SYS_VENDOR, "LENOVO"),
+			DMI_MATCH(DMI_PRODUCT_FAMILY, "ThinkPad T495"),
+		},
+		.driver_data = (void *)&ucsi_t495_ops,
+	},
 	{ }
 };
 
